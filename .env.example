# Frontend environment (copy to .env.local for local development)

# Backend API base URL (REQUIRED — no fallback; the build fails without it)
# Local dev: http://localhost:5000/api
# Production (Vercel): https://architect-portfolio-backend-5bow.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical site origin (REQUIRED — no fallback; the build fails without it)
# Used for metadataBase, canonical URLs, Open Graph, JSON-LD schemas, robots.txt, sitemap
# Local dev: http://localhost:3000
# Production (Vercel): https://www.dibeh-architecture.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TinyMCE rich-text editor API key (admin blog/news editors)
# Get one at https://www.tiny.cloud/auth/signup/
NEXT_PUBLIC_TINYMCE_API_KEY=your_tinymce_api_key

# On-demand ISR revalidation secret (REQUIRED — /api/revalidate rejects all requests without it)
# Must match REVALIDATION_SECRET in the backend environment (backend/.env locally, Render in production)
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=your_revalidation_secret_generate_with_openssl_rand_hex_32
